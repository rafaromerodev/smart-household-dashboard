# Copy to .env.local and fill in with your Supabase project values
# (Supabase → Project Settings → API, or the output of `npm run db:start` locally).
# The anon key is public by design: access control is enforced by RLS policies.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
